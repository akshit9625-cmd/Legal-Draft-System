# Application
APP_NAME=LegalDraftAI
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=legal_draft_db
POSTGRES_USER=legaluser
POSTGRES_PASSWORD=legalpass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_SECONDS=86400

# ML Models
HF_MODEL_CLASSIFIER=distilbert-base-uncased
HF_MODEL_GENERATOR=google/flan-t5-base
GGUF_MODEL_PATH=.cache/models/llama-3.2-1b-instruct.Q4_K_M.gguf
SPACY_MODEL=en_core_web_sm
USE_GPU=false

# Optional: LLM API fallback
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
